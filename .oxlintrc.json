{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "eslint",
    "typescript",
    "oxc",
    "import",
    "react",
    "nextjs",
    "jsx-a11y",
    "vitest"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "settings": {
    "react": {
      "version": "19.2.7"
    }
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "eslint/no-underscore-dangle": "off",
    "import/no-unassigned-import": [
      "error",
      { "allow": ["**/*.css", "**/*.scss"] }
    ]
  },
  "ignorePatterns": [".next/**", "dist/**", "build/**", "public/**"],
  "overrides": [
    {
      "files": ["src/**/__tests__/**", "src/**/*.test.{ts,tsx}"],
      "rules": {
        "typescript/no-explicit-any": "off"
      }
    }
  ]
}
